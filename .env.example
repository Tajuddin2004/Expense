# ==============================================================================
# ENVIRONMENT CONFIGURATION - Django Expense Tracker
# ==============================================================================

# 1. MySQL Database Configuration
# Option A: MySQL Connection URL (Cloud MySQL or Local)
# Example: mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/expense_db
DATABASE_URL=

# Option B: Individual MySQL credentials (leave empty if using DATABASE_URL)
# MYSQL_NAME=expense_tracker
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# (Note: If neither is set, Django safely falls back to local SQLite)

# 2. Google SMTP Configuration (Gmail)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password

# 3. Security
SECRET_KEY=django-insecure-o*=o!!(&fk@6+b=0=kxlcy2y%w20pnye311et^(q%d0n2q3d(j
DEBUG=True
